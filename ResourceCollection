function handleGetLogActivity(ss, requestData) {
  var r = readSheet(ss, SHEET_ACTIVITY_LOG);
  var logs = r.data
    .filter(function(row){ return !!row[0]; })
    .map(function(row){
      return { timestamp: formatDateSafe(row[0]), userId: String(row[1]||""),
               role: String(row[2]||""), detail: String(row[3]||"") };
    }).reverse();
  return ok({ logs: logs });
}

function handleLogin(ss, requestData) {
  var userId = String(requestData.userId || requestData.userid || "").trim();
  var pin    = String(requestData.pin    || "").trim();
  if (!userId || !pin) return err("User ID dan PIN wajib diisi.");

  var authRes  = readSheet(ss, SHEET_AUTHORITY);
  var authData = authRes.data;

  var loginSuccess = false;
  var userData = {};
  var allDepotsList = [];

  for (var i = 0; i < authData.length; i++) {
    if (String(authData[i][4]||"").trim() !== userId) continue;
    if (String(authData[i][5]||"").trim() !== pin)    continue;

    var actRaw  = String(authData[i][8]||"").trim().toLowerCase();
    var userRole= String(authData[i][7]||"").trim() || "admin";
    var sysRole = normalizeRole(userRole);

    if (actRaw !== "approved" && actRaw !== "ok" && actRaw !== "active") break;

    loginSuccess = true;
    var depotNameAuth  = normalizeName(String(authData[i][3]||""));
    var regAuto        = String(authData[i][0]||"");
    var kodeDepotAuto  = String(authData[i][2]||"").trim();
    var isSysMgr       = (sysRole === 'system manager');

    var dmo = buildDepoMasterMaps(ss);
    var dm  = dmo.data;
    var explicitDepots = [];
    var depotDetailObj = null;

    for (var d = 0; d < dm.length; d++) {
      var dKode = String(dm[d][1]||"").trim();
      if (!dKode) continue;
      var oscArr    = String(dm[d][10]||"").split(",").map(function(u){return u.trim();});
      var nonOscArr = String(dm[d][11]||"").split(",").map(function(u){return u.trim();});
      var adm1=String(dm[d][7]||"").trim(), adm2=String(dm[d][8]||"").trim(), adm3=String(dm[d][9]||"").trim();

      var hasAccess = (sysRole === "supervisor" || sysRole === "system manager" || oscArr.indexOf(userId) !== -1 || nonOscArr.indexOf(userId) !== -1);

      if (sysRole === "admin" && (adm1===userId||adm2===userId||adm3===userId||dKode===kodeDepotAuto)) {
        hasAccess = true;
        if (dKode === kodeDepotAuto) {
          regAuto = String(dm[d][0]||"");
          depotNameAuth = dmo.nameMap[dKode];
          depotDetailObj = {
            region: String(dm[d][0]||"").trim(), kode: dKode, nama: dmo.nameMap[dKode],
            kepalaDepot: String(dm[d][3]||"").trim(), kepalaAdmin: String(dm[d][4]||"").trim(),
            users: [adm1,adm2,adm3].filter(Boolean), picOsc: String(dm[d][10]||"").trim(),
            masterLink: String(dm[d][12]||"").trim()
          };
        }
      }
      if (hasAccess) explicitDepots.push(dKode.toUpperCase());
    }

    var managedDepots = resolveManagedDepots(explicitDepots, dmo.subTagsMap);

    for (var d2 = 0; d2 < dm.length; d2++) {
      var dc = String(dm[d2][1]||"").trim().toUpperCase();
      if (!dc) continue;
      if (isSysMgr || managedDepots.indexOf(dc) !== -1) {
        allDepotsList.push({ kode: dc, nama: normalizeName(String(dm[d2][2]||"")), link: String(dm[d2][12]||"").trim() });
      }
    }

    if (sysRole !== "admin") { depotNameAuth = "Head Office"; regAuto = "0"; kodeDepotAuto = "0"; }

    var sfx = ("000" + String(authData[i][17]||"000")).slice(-3);

    // Server Generated Token (Replace Base64)
    var secureToken = generateToken(userId, sysRole, sfx);

    userData = {
      userId: String(authData[i][4]||""), namaLengkap: String(authData[i][1]||""),
      role: userRole, sysRole: sysRole, depot: depotNameAuth,
      kodeDepot: kodeDepotAuto, regional: regAuto, activation: actRaw, suffixNum: sfx,
      auth: {
        j: String(authData[i][9] ||"") || (isSysMgr?"Yes":"Hidden"),
        k: String(authData[i][10]||"") || (isSysMgr?"Yes":"No"),
        l: String(authData[i][11]||"") || (isSysMgr?"Yes":"No"),
        m: String(authData[i][12]||"") || (isSysMgr?"Yes":"No"),
        n: String(authData[i][13]||"") || (isSysMgr?"Yes":"No"),
        p: String(authData[i][15]||"") || (isSysMgr?"Yes":"No"),
        q: String(authData[i][16]||"") || (isSysMgr?"Yes":"No"),
        s: String(authData[i][18]||"") || (isSysMgr?"Yes":"No")
      },
      managedDepots: managedDepots, depotDetail: depotDetailObj,
      token: secureToken
    };
    break;
  }

  if (!loginSuccess) return err("Kredensial tidak valid atau akun dinonaktifkan.");

  var compRes  = readSheet(ss, SHEET_COMPILE);
  var campRes  = readSheet(ss, SHEET_LIST_CAMPAIGN);
  var custRes  = readSheet(ss, SHEET_CUSTOMER_DB);

  var listCompile = buildDocumentsList(compRes);

  // Master Code (kolom V) & Master Code Name (kolom W) dipakai FE khusus untuk grouping
  // reporting di Analytics (Summary Chart/Executive Summary) - Jenis CB & campaign code individual
  // (kolom A) tetap dipakai apa adanya untuk Claim Upload/Posting, tidak berubah.
  var listCampaign = campRes.data
    .filter(function(r){ return String(r[0]||"").trim() !== ""; })
    .map(function(r){
      return {
        codeCampaign: String(r[0]||"").trim(), campaignName: String(r[1]||"").trim(),
        periodStart: formatDateSafe(r[2]), periodEnd: formatDateSafe(r[3]),
        statusPajak: String(r[5]||"").trim(), jenisCb: String(r[6]||"").trim(),
        masterCode: String(r[21]||"").trim(), masterCodeName: String(r[22]||"").trim()
      };
    });

  var listCust = custRes.data
    .filter(function(r){ return String(r[1]||"").trim() !== ""; })
    .map(function(r){
      return {
        custCode: String(r[1]||"").trim(), noRek: String(r[3]||"").trim(),
        namaRek: String(r[4]||"").trim(), bank: String(r[5]||"").trim(),
        npwp: String(r[6]||"").trim(), ktp: String(r[7]||"").trim(),
        subyekPajak: String(r[8]||"").trim(), top: String(r[10]||"").trim()
      };
    });

  return ok({ data: userData, documents: listCompile, campaigns: listCampaign, customers: listCust, depots: allDepotsList });
}

function handleSubmitData(ss, requestData) {
  var payloadData = Array.isArray(requestData.data) ? requestData.data : [requestData.data];
  if (payloadData.length === 0) return err("Tidak ada data diproses.");

  var lock = LockService.getScriptLock();
  lock.waitLock(30000);

  try {
    var tsUpload = Utilities.formatDate(new Date(), "Asia/Jakarta", "dd-MMM-yyyy HH:mm:ss");
    var compRes = readSheet(ss, SHEET_COMPILE);
    var custRes = readSheet(ss, SHEET_CUSTOMER_DB);
    var compileSheet = compRes.sheet;
    var custSheet = custRes.sheet;

    var docMap = {};
    compRes.data.forEach(function(r, idx){
      var d = String(r[COL_COMPILE.NO_DOC]||"").trim().toUpperCase();
      if (d) docMap[d] = idx;
    });

    var custMap = {};
    custRes.data.forEach(function(r, idx){
      var c = String(r[1]||"").trim();
      if (c) custMap[c] = idx;
    });

    var safeBatchUpload = generateSecureBatchNumber("01", requestData.serverAuth.suffixNum || "000");
    var successCount = 0, errors = [], successfulDocs = [], grossUpMap = {}, custWrites = {};

    for (var k = 0; k < payloadData.length; k++) {
      var d = payloadData[k];
      var docUp = String(d.noDoc||"").trim().toUpperCase();
      var rowIdx = docMap[docUp];
      if (rowIdx === undefined) { errors.push("No Doc tidak ditemukan: " + docUp); continue; }

      var curStat = String(compRes.data[rowIdx][COL_COMPILE.STATUS]||"").trim();

      // SECURITY: dokumen berstatus On Hold TIDAK BOLEH diupload/di-claim ulang secara langsung -
      // perubahan statusnya hanya lewat Posting Exception (toggleOnHold/markExpired). Expired sudah
      // terkunci permanen lewat isValidStatusTransition (cur === "expired" => false).
      if (curStat.trim().toLowerCase() === "on hold") {
        errors.push("Dokumen " + docUp + " sedang berstatus On Hold dan tidak dapat diupload. Batalkan On Hold terlebih dahulu lewat Posting Exception.");
        continue;
      }

      // SERVER-SIDE STATE VALIDATION
      if (!isValidStatusTransition(curStat, WORKFLOW_STATUS.SUBMITTED)) {
        errors.push("Dokumen " + docUp + " berstatus '" + curStat + "' dan tidak dapat di-upload.");
        continue;
      }

      var cIdx = custMap[d.custCode];
      if (cIdx !== undefined) {
        var cr = custRes.data[cIdx];
        var changed = false;
        var inNoRek = String(d.noRekening||"").trim(), inNamaRek = String(d.pemilikRekening||"").trim(), inBank = String(d.bankCust||"").trim();
        var inNpwp = String(d.npwp||"").trim(), inKtp = String(d.ktp||"").trim(), inSubyek = String(d.subyekPajak||"").trim(), inTop = String(d.top||"").trim();

        if (inNoRek && inNoRek !== String(cr[3]||"").trim()) { cr[3] = inNoRek; changed = true; }
        if (inNamaRek && inNamaRek !== String(cr[4]||"").trim()) { cr[4] = inNamaRek; changed = true; }
        if (inBank && inBank !== String(cr[5]||"").trim()) { cr[5] = inBank; changed = true; }
        if (inNpwp && inNpwp !== String(cr[6]||"").trim()) { cr[6] = inNpwp; changed = true; }
        if (inKtp && inKtp !== String(cr[7]||"").trim()) { cr[7] = inKtp; changed = true; }
        if (inSubyek && inSubyek !== String(cr[8]||"").trim()) { cr[8] = inSubyek; changed = true; }
        if (inTop && parseFloat(inTop) > 0 && inTop !== String(cr[10]||"").trim()) { cr[10] = inTop; changed = true; }

        if (changed) custWrites[cIdx + 2] = [cr[3],cr[4],cr[5],cr[6],cr[7],cr[8],cr[9],cr[10]];
      }

      var totTagih = (d.totTagih !== undefined && d.totTagih !== "") ? normalizeCurrency(d.totTagih) : 0;
      var vals = [
        d.periodStart, d.campaignEnd, d.jenisCashback, d.ktp, d.npwp, d.statusPajakCampaign, d.tglLunas, d.top, d.approval,
        normalizeMonth(d.blnTagih1), normalizeMonth(d.blnTagih2), normalizeMonth(d.blnTagih3), normalizeMonth(d.blnTagih4),
        totTagih, d.subyekPajak, WORKFLOW_STATUS.SUBMITTED, tsUpload, "", "", "", safeBatchUpload, "", "", ""
      ];

      for (var v = 0; v < vals.length; v++) compRes.data[rowIdx][11 + v] = vals[v];

      // HITUNG GROSS UP SINKRON
      var netCbForGrossUp = compRes.data[rowIdx][COL_COMPILE.CB_NET];
      var grossUpVal = calcGrossUpCB(netCbForGrossUp, d.subyekPajak, d.statusPajakCampaign);
      compRes.data[rowIdx][COL_COMPILE.GROSS_UP] = grossUpVal;
      grossUpMap[docUp] = grossUpVal;

      compRes.data[rowIdx][COL_COMPILE.NO_REKENING] = String(d.noRekening || "").trim();
      compRes.data[rowIdx][COL_COMPILE.NAMA_REKENING] = String(d.pemilikRekening || "").trim();
      compRes.data[rowIdx][COL_COMPILE.BANK] = String(d.bankCust || "").trim();

      successCount++;
      successfulDocs.push(docUp);
    }

    if (successCount > 0) {
      var updatedRows = successfulDocs.map(function(doc){ return docMap[doc]; }).sort(function(a,b){return a-b;});
      var blocks = []; var blk = [updatedRows[0]];
      for (var u = 1; u < updatedRows.length; u++) {
        if (updatedRows[u] === blk[blk.length-1] + 1) { blk.push(updatedRows[u]); }
        else { blocks.push(blk); blk = [updatedRows[u]]; }
      }
      blocks.push(blk);

      blocks.forEach(function(block) {
        var startRow = block[0] + 2;
        var writeData = block.map(function(ri){ return compRes.data[ri].slice(11, 35); });
        compileSheet.getRange(startRow, 15, block.length, 2).setNumberFormat("@");
        compileSheet.getRange(startRow, 12, block.length, 24).setValues(writeData);
      });

      blocks.forEach(function(block) {
        var startRow = block[0] + 2;
        var grossUpVals = block.map(function(ri){ return [compRes.data[ri][COL_COMPILE.GROSS_UP]]; });
        compileSheet.getRange(startRow, COL_COMPILE.GROSS_UP + 1, block.length, 1).setValues(grossUpVals);
      });

      blocks.forEach(function(block) {
        var startRow = block[0] + 2;
        var rekVals = block.map(function(ri){ return [compRes.data[ri][COL_COMPILE.NO_REKENING], compRes.data[ri][COL_COMPILE.NAMA_REKENING], compRes.data[ri][COL_COMPILE.BANK]]; });
        compileSheet.getRange(startRow, COL_COMPILE.NO_REKENING + 1, block.length, 1).setNumberFormat("@");
        compileSheet.getRange(startRow, COL_COMPILE.NO_REKENING + 1, block.length, 3).setValues(rekVals);
      });
    }

    Object.keys(custWrites).forEach(function(sheetRow) {
      if (custSheet) {
        var rowNum = parseInt(sheetRow);
        custSheet.getRange(rowNum, 4, 1, 1).setNumberFormat("@");
        custSheet.getRange(rowNum, 7, 1, 1).setNumberFormat("@");
        custSheet.getRange(rowNum, 8, 1, 1).setNumberFormat("@");
        custSheet.getRange(rowNum, 4, 1, 8).setValues([custWrites[sheetRow]]);
      }
    });

    var msg = "Berhasil memproses data.";
    var summary = { successCount: successCount, successfulDocs: successfulDocs, batchNum: safeBatchUpload, grossUpMap: grossUpMap };
    if (errors.length > 0) return warn(msg + " Peringatan: " + errors.join(" | "), { summary: summary });
    return successCount > 0 ? ok({ message: msg, summary: summary }) : err("Tidak ada data valid yang diproses.");

  } finally {
    lock.releaseLock();
  }
}

function handleGetWorkflowData(ss, requestData) {
  var reqId   = requestData.requesterId;
  var sysRole = normalizeRole(requestData.requesterRole);
  var managed = requestData.managedDepots || [];

  var dmo     = buildDepoMasterMaps(ss);
  var compRes = readSheet(ss, SHEET_COMPILE);
  var campJenisCbMap = buildCampaignJenisCbMap(ss);

  var releaseData = [], claimFinData = [], clearingData = [], bulkRebateData = [];

  compRes.data.forEach(function(r) {
    var noDoc  = String(r[COL_COMPILE.NO_DOC]||"").trim(); if (!noDoc) return;
    var status = String(r[COL_COMPILE.STATUS]||"").trim();
    var kd     = String(r[COL_COMPILE.DC_CODE]||"").trim().toUpperCase();
    var picOsc = dmo.picMap[kd] || "";
    var depot  = dmo.nameMap[kd] || normalizeName(String(r[COL_COMPILE.DEPOT_NAME]||""));
    // Jenis CB diambil dari master ListCampaign (live), bukan snapshot kolom JENIS_CB di Compile -
    // supaya dokumen lama juga ikut terdeteksi Rebate begitu campaign-nya diset "Rebate" di master,
    // tanpa perlu re-upload. Fallback ke kolom Compile kalau campaign-nya tidak ketemu di master.
    var codeCampUp = String(r[COL_COMPILE.CODE_CAMPAIGN]||"").trim().toUpperCase();
    var jenisCb = campJenisCbMap[codeCampUp] || String(r[COL_COMPILE.JENIS_CB]||"").trim();
    var isRebate = jenisCb.toLowerCase() === "rebate";

    var allowed = (sysRole==='supervisor'||sysRole==='system manager')
      || (sysRole==='osc' && (picOsc===reqId || managed.indexOf(kd)!==-1))
      || managed.indexOf(kd) !== -1;

    if (!(status==="Submitted" || status==="Released" || status==="Claimed")) return;

    // Jenis CB "Rebate" tidak lagi lewat Release/Claim to Finance/Clearing satu-per-satu -
    // semua tahap (Submitted/Released/Claimed) dikumpulkan ke bulkRebateData untuk diproses
    // langsung ke Done lewat modul Bulk Process. Dibatasi scope depot/authority user (allowed).
    if (isRebate) { if (!allowed) return; }
    else if (!((allowed && status==="Submitted") || status==="Released" || status==="Claimed")) return;

    var row = {
      noDoc: noDoc, depot: depot, kodeDepot: kd,
      codeCampaign: String(r[COL_COMPILE.CODE_CAMPAIGN]||""), campaignName: String(r[COL_COMPILE.CAMPAIGN_NAME]||""),
      kodeToko: String(r[COL_COMPILE.CUST_CODE]||""), namaToko: normalizeName(String(r[COL_COMPILE.CUST_NAME]||"")),
      periode: formatDateSafe(r[COL_COMPILE.PERIOD_START]) + " s/d " + formatDateSafe(r[COL_COMPILE.CAMPAIGN_END]),
      periodeStart: formatDateSafe(r[COL_COMPILE.PERIOD_START]), periodeEnd: formatDateSafe(r[COL_COMPILE.CAMPAIGN_END]),
      cbNet: r[COL_COMPILE.CB_NET], grossUpCb: r[COL_COMPILE.GROSS_UP] || 0, totTagih: r[COL_COMPILE.TOT_TAGIH] ? normalizeCurrency(r[COL_COMPILE.TOT_TAGIH]) : 0,
      ktp: String(r[COL_COMPILE.KTP]||""), npwp: String(r[COL_COMPILE.NPWP]||""),
      noRekening: String(r[COL_COMPILE.NO_REKENING]||""), namaRekening: String(r[COL_COMPILE.NAMA_REKENING]||""), bank: String(r[COL_COMPILE.BANK]||""),
      statusPajakCamp: String(r[COL_COMPILE.STATUS_PAJAK_CAMP]||""), tglLunas: formatDateSafe(r[COL_COMPILE.TGL_LUNAS]),
      top: String(r[COL_COMPILE.TOP]||""), approval: String(r[COL_COMPILE.APPROVAL]||""),
      statusPajakCust: String(r[COL_COMPILE.SUBYEK_PAJAK]||""), jenisCb: jenisCb,
      tglUpload:   formatDateSafe(r[COL_COMPILE.TGL_UPLOAD]), tglRelease:  formatDateSafe(r[COL_COMPILE.TGL_RELEASE]),
      tglClaim:    formatDateSafe(r[COL_COMPILE.TGL_CLAIM]), tglClearing: formatDateSafe(r[COL_COMPILE.TGL_CLEARING]),
      batchUpload:   String(r[COL_COMPILE.BATCH_UPLOAD]||""), batchRelease:  String(r[COL_COMPILE.BATCH_RELEASE]||""),
      batchClaim:    String(r[COL_COMPILE.BATCH_CLAIM]||""), batchClearing: String(r[COL_COMPILE.BATCH_CLEARING]||""),
      status: status
    };

    if (isRebate) { bulkRebateData.push(row); return; }

    if (status==="Submitted" && allowed) releaseData.push(row);
    else if (status==="Released") claimFinData.push(row);
    else if (status==="Claimed")  clearingData.push(row);
  });

  return ok({ releaseData: releaseData, claimFinData: claimFinData, clearingData: clearingData, bulkRebateData: bulkRebateData });
}

function handleProcessWorkflow(ss, requestData) {
  var docsToProcess = requestData.docsToProcess;
  var workflowType  = requestData.workflowType;
  var actionType    = requestData.actionType || "approve";

  if (!docsToProcess || docsToProcess.length === 0) return err("Data tidak lengkap.");

  var lock = LockService.getScriptLock();
  lock.waitLock(30000);

  try {
    var tglProses = requestData.tglProses || Utilities.formatDate(new Date(), "Asia/Jakarta", "dd-MMM-yyyy HH:mm:ss");
    var safeWorkflowBatch = "";
    if (actionType === "approve") {
      var sc = workflowType==="release" ? "02" : workflowType==="claim" ? "03" : "04";
      safeWorkflowBatch = generateSecureBatchNumber(sc, requestData.serverAuth.suffixNum || "000");
    }

    var expectStatus = { release:"Submitted", claim:"Released", clearing:"Claimed" };
    var newStatus    = { release:"Released",  claim:"Claimed",  clearing:"Done"    };
    var rejectStatus = { release:"Not Yet",   claim:"Submitted",clearing:"Released" };

    var docSet = {};
    docsToProcess.forEach(function(d){ docSet[d] = true; });

    var compRes      = readSheet(ss, SHEET_COMPILE);
    var compileSheet = compRes.sheet;
    var compData     = compRes.data;

    var colCfg = {
      release:  { tglCol: COL_COMPILE.TGL_RELEASE, batchCol: COL_COMPILE.BATCH_RELEASE },
      claim:    { tglCol: COL_COMPILE.TGL_CLAIM, batchCol: COL_COMPILE.BATCH_CLAIM },
      clearing: { tglCol: COL_COMPILE.TGL_CLEARING, batchCol: COL_COMPILE.BATCH_CLEARING }
    };
    var rejectClear = {
      release:  { tglCol: COL_COMPILE.TGL_UPLOAD, batchCol: COL_COMPILE.BATCH_UPLOAD },
      claim:    { tglCol: COL_COMPILE.TGL_RELEASE, batchCol: COL_COMPILE.BATCH_RELEASE },
      clearing: { tglCol: COL_COMPILE.TGL_CLAIM, batchCol: COL_COMPILE.BATCH_CLAIM }
    };

    var cfg  = colCfg[workflowType];
    var rcfg = rejectClear[workflowType];
    var processedCount = 0;
    var successfulDocs = [];
    var writes = {};

    for (var r = 0; r < compData.length; r++) {
      var doc = String(compData[r][COL_COMPILE.NO_DOC]||"").trim();
      if (!doc || !docSet[doc]) continue;

      var curStat = String(compData[r][COL_COMPILE.STATUS]||"").trim();

      var targetState = "";
      if (actionType === "approve") targetState = newStatus[workflowType];
      else if (actionType === "reject") targetState = "reject_" + workflowType; // helper for state machine
      else if (actionType === "expired") targetState = WORKFLOW_STATUS.EXPIRED;

      // Validate Transition
      if (!isValidStatusTransition(curStat, targetState)) continue;

      if (actionType === "approve") {
        writes[r] = writes[r] || {};
        writes[r][COL_COMPILE.STATUS] = newStatus[workflowType];
        writes[r][cfg.tglCol]   = tglProses;
        writes[r][cfg.batchCol] = safeWorkflowBatch;
      } else if (actionType === "reject") {
        writes[r] = writes[r] || {};
        writes[r][COL_COMPILE.STATUS] = rejectStatus[workflowType];
        writes[r][rcfg.tglCol]   = "";
        writes[r][rcfg.batchCol] = "";
      } else if (actionType === "expired") {
        writes[r] = writes[r] || {};
        writes[r][COL_COMPILE.STATUS] = WORKFLOW_STATUS.EXPIRED;
      }

      processedCount++;
      successfulDocs.push(doc);
    }

    if (processedCount > 0) {
      var byCol = {};
      Object.keys(writes).forEach(function(ri) {
        ri = parseInt(ri);
        Object.keys(writes[ri]).forEach(function(ci) {
          ci = parseInt(ci);
          compData[ri][ci] = writes[ri][ci];
          if (!byCol[ci]) byCol[ci] = [];
          byCol[ci].push(ri);
        });
      });

      Object.keys(byCol).forEach(function(ci) {
        ci = parseInt(ci);
        var rows = byCol[ci].sort(function(a,b){return a-b;});
        var blocks = []; var blk = [rows[0]];
        for (var x = 1; x < rows.length; x++) {
          if (rows[x] === blk[blk.length-1] + 1) blk.push(rows[x]);
          else { blocks.push(blk); blk = [rows[x]]; }
        }
        blocks.push(blk);

        var sheetCol = ci + 1;
        blocks.forEach(function(block) {
          var startRow = block[0] + 2;
          var vals = block.map(function(ri){ return [compData[ri][ci]]; });
          compileSheet.getRange(startRow, sheetCol, block.length, 1).setValues(vals);
        });
      });
    }

    return ok({ message: processedCount + " dokumen berhasil diproses.",
                summary: { successCount: processedCount, successfulDocs: successfulDocs, batchNum: safeWorkflowBatch } });
  } finally {
    lock.releaseLock();
  }
}

function handleToggleOnHold(ss, requestData) {
  var docsToProcess = requestData.docsToProcess;
  var holdAction    = requestData.holdAction;
  if (!docsToProcess || docsToProcess.length === 0) return err("Data tidak lengkap.");
  if (holdAction !== "hold" && holdAction !== "unhold") return err("holdAction tidak valid.");

  var docSet = {};
  docsToProcess.forEach(function(d){ docSet[d] = true; });

  // Lock ditambahkan supaya konsisten dengan submitData/processWorkflow/bulkFastTrackRelease -
  // tanpa lock, aksi Hold/Unhold yang jalan bersamaan dengan handler lain yang menulis ke sheet
  // Compile bisa saling menimpa perubahan satu sama lain (race condition pada baris yang sama).
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    var compRes      = readSheet(ss, SHEET_COMPILE);
    var compileSheet = compRes.sheet;
    var compData     = compRes.data;

    var processedCount = 0;
    var successfulDocs = [];
    var writesStatus = {};
    var writesPrev   = {};

    for (var r = 0; r < compData.length; r++) {
      var doc = String(compData[r][COL_COMPILE.NO_DOC]||"").trim();
      if (!doc || !docSet[doc]) continue;

      var curStat = String(compData[r][COL_COMPILE.STATUS]||"").trim();
      var curStatLow = curStat.toLowerCase();

      if (holdAction === "hold") {
        // Posting Exception: dokumen boleh ditahan (On Hold) dari status apa pun di sepanjang
        // alur Upload->Release->Claim->Clearing, ASALKAN belum final (Done/Expired). Dicek langsung
        // di sini (bukan lewat isValidStatusTransition) karena Hold adalah aksi override di luar
        // alur normal, bukan bagian dari state machine approve/reject standar.
        if (curStatLow === "done" || curStatLow === "expired" || curStatLow === "on hold") continue;
        writesStatus[r] = WORKFLOW_STATUS.ON_HOLD;
        writesPrev[r]   = curStat || WORKFLOW_STATUS.NOT_YET;
      } else {
        if (curStatLow !== "on hold") continue;
        var prevStat = String(compData[r][COL_COMPILE.PREV_STATUS]||"").trim() || WORKFLOW_STATUS.NOT_YET;
        writesStatus[r] = prevStat;
        writesPrev[r]   = "";
      }

      processedCount++;
      successfulDocs.push(doc);
    }

    if (processedCount > 0) {
      var rows = Object.keys(writesStatus).map(function(x){ return parseInt(x); }).sort(function(a,b){return a-b;});
      var blocks = []; var blk = [rows[0]];
      for (var x = 1; x < rows.length; x++) {
        if (rows[x] === blk[blk.length-1] + 1) blk.push(rows[x]);
        else { blocks.push(blk); blk = [rows[x]]; }
      }
      blocks.push(blk);

      blocks.forEach(function(block) {
        var startRow = block[0] + 2;
        var statusVals = block.map(function(ri){ return [writesStatus[ri]]; });
        compileSheet.getRange(startRow, COL_COMPILE.STATUS + 1, block.length, 1).setValues(statusVals);
        var prevVals = block.map(function(ri){ return [writesPrev[ri]]; });
        compileSheet.getRange(startRow, COL_COMPILE.PREV_STATUS + 1, block.length, 1).setValues(prevVals);
      });
    }
    var msg = processedCount + " dokumen berhasil " + (holdAction==="hold" ? "ditahan (On Hold)." : "dibatalkan status On Hold-nya.");
    return ok({ message: msg, summary: { successCount: processedCount, successfulDocs: successfulDocs } });
  } finally {
    lock.releaseLock();
  }
}

function handleMarkExpired(ss, requestData) {
  var docsToProcess = requestData.docsToProcess;
  if (!docsToProcess || docsToProcess.length === 0) return err("Data tidak lengkap.");

  var docSet = {};
  docsToProcess.forEach(function(d){ docSet[d] = true; });

  // Lock ditambahkan supaya konsisten dengan submitData/processWorkflow/bulkFastTrackRelease -
  // tanpa lock, aksi markExpired yang jalan bersamaan dengan handler lain yang menulis ke sheet
  // Compile bisa saling menimpa perubahan satu sama lain (race condition pada baris yang sama).
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    var compRes      = readSheet(ss, SHEET_COMPILE);
    var compileSheet = compRes.sheet;
    var compData     = compRes.data;

    var processedCount = 0;
    var successfulDocs = [];
    var rowsToUpdate   = [];

    for (var r = 0; r < compData.length; r++) {
      var doc = String(compData[r][COL_COMPILE.NO_DOC]||"").trim();
      if (!doc || !docSet[doc]) continue;

      var curStat = String(compData[r][COL_COMPILE.STATUS]||"").trim().toLowerCase();

      // Posting Exception: Expired bisa ditandai dari status apa pun (termasuk On Hold) selama belum
      // Done atau sudah Expired sebelumnya - dicek langsung, bukan lewat isValidStatusTransition,
      // karena ini aksi override di luar alur approve/reject standar.
      if (curStat === "done" || curStat === "expired") continue;

      rowsToUpdate.push(r);
      processedCount++;
      successfulDocs.push(doc);
    }

    if (processedCount > 0) {
      rowsToUpdate.sort(function(a,b){return a-b;});
      var blocks = []; var blk = [rowsToUpdate[0]];
      for (var u = 1; u < rowsToUpdate.length; u++) {
        if (rowsToUpdate[u] === blk[blk.length-1] + 1) blk.push(rowsToUpdate[u]);
        else { blocks.push(blk); blk = [rowsToUpdate[u]]; }
      }
      blocks.push(blk);
      blocks.forEach(function(block) {
        var startRow = block[0] + 2;
        var vals = block.map(function(){ return [WORKFLOW_STATUS.EXPIRED]; });
        compileSheet.getRange(startRow, COL_COMPILE.STATUS + 1, block.length, 1).setValues(vals);
      });
    }

    return ok({ message: processedCount + " dokumen ditandai Expired (permanen).",
                summary: { successCount: processedCount, successfulDocs: successfulDocs } });
  } finally {
    lock.releaseLock();
  }
}

function handleBulkFastTrackRelease(ss, requestData) {
  var docsToProcess = requestData.docsToProcess;
  if (!docsToProcess || docsToProcess.length === 0) return err("Data tidak lengkap.");

  var docSet = {};
  docsToProcess.forEach(function(d){ docSet[d] = true; });

  var lock = LockService.getScriptLock();
  lock.waitLock(30000);

  try {
    var compRes      = readSheet(ss, SHEET_COMPILE);
    var compileSheet = compRes.sheet;
    var compData     = compRes.data;
    var campJenisCbMap = buildCampaignJenisCbMap(ss);

    var safeBatch = generateSecureBatchNumber("02", requestData.serverAuth.suffixNum || "000");

    var processedCount = 0, successfulDocs = [], skippedNonRebate = [], rowsToUpdate = [];

    for (var r = 0; r < compData.length; r++) {
      var doc = String(compData[r][COL_COMPILE.NO_DOC]||"").trim();
      if (!doc || !docSet[doc]) continue;

      var curStat = String(compData[r][COL_COMPILE.STATUS]||"").trim().toLowerCase();
      // Bulk Process meng-copy scope Release tapi bypass langsung ke Done - berlaku untuk dokumen
      // Rebate di TIGA tahap sekaligus (Submitted/Released/Claimed), bukan cuma Submitted. Dicek
      // langsung (bukan lewat isValidStatusTransition) karena "released"->"done" bukan transisi
      // normal di state machine approve/reject standar.
      if (curStat !== "submitted" && curStat !== "released" && curStat !== "claimed") continue;

      // Jenis CB dicek dari master ListCampaign (sama seperti handleGetWorkflowData) supaya
      // dokumen yang tampil di tabel Bulk Process (frontend) selalu konsisten bisa dieksekusi di sini -
      // fallback ke kolom Compile kalau campaign-nya tidak ketemu di master.
      var codeCampUp = String(compData[r][COL_COMPILE.CODE_CAMPAIGN]||"").trim().toUpperCase();
      var jenisCb = (campJenisCbMap[codeCampUp] || String(compData[r][COL_COMPILE.JENIS_CB]||"")).trim().toLowerCase();
      if (jenisCb !== "rebate") { skippedNonRebate.push(doc); continue; }

      rowsToUpdate.push(r);
      processedCount++;
      successfulDocs.push(doc);
    }

    if (processedCount > 0) {
      rowsToUpdate.sort(function(a,b){return a-b;});
      var blocks = []; var blk = [rowsToUpdate[0]];
      for (var u = 1; u < rowsToUpdate.length; u++) {
        if (rowsToUpdate[u] === blk[blk.length-1] + 1) blk.push(rowsToUpdate[u]);
        else { blocks.push(blk); blk = [rowsToUpdate[u]]; }
      }
      blocks.push(blk);

      blocks.forEach(function(block) {
        var startRow = block[0] + 2;
        compileSheet.getRange(startRow, COL_COMPILE.STATUS + 1, block.length, 1).setValues(block.map(function(){ return [WORKFLOW_STATUS.DONE]; }));
        compileSheet.getRange(startRow, COL_COMPILE.TGL_RELEASE + 1, block.length, 1).setValues(block.map(function(){ return ["x"]; }));
        compileSheet.getRange(startRow, COL_COMPILE.BATCH_RELEASE + 1, block.length, 1).setValues(block.map(function(){ return [safeBatch]; }));
        compileSheet.getRange(startRow, COL_COMPILE.TGL_CLAIM + 1, block.length, 1).setValues(block.map(function(){ return ["x"]; }));
        compileSheet.getRange(startRow, COL_COMPILE.BATCH_CLAIM + 1, block.length, 1).setValues(block.map(function(){ return ["x"]; }));
        compileSheet.getRange(startRow, COL_COMPILE.TGL_CLEARING + 1, block.length, 1).setValues(block.map(function(){ return ["x"]; }));
        compileSheet.getRange(startRow, COL_COMPILE.BATCH_CLEARING + 1, block.length, 1).setValues(block.map(function(){ return ["x"]; }));
      });
    }

    return ok({ message: processedCount + " dokumen berhasil diproses langsung ke Done.",
                summary: { successCount: processedCount, successfulDocs: successfulDocs, batchNum: safeBatch, skippedNonRebate: skippedNonRebate } });
  } finally {
    lock.releaseLock();
  }
}

function handleGetDashboardData(ss, requestData) {
  var reqId   = requestData.requesterId;
  var sysRole = normalizeRole(requestData.requesterRole);
  var managed = requestData.managedDepots || [];

  var dmo     = buildDepoMasterMaps(ss);
  var compRes = readSheet(ss, SHEET_COMPILE);

  var history = [], compileData = [];

  compRes.data.forEach(function(r) {
