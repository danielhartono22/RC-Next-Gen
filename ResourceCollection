function handleApproveProfileRequest(ss, requestData) {
  var rId      = requestData.reqId;
  var statAct  = String(requestData.status||"").toUpperCase();
  if (!rId || !statAct) return err("reqId dan status wajib diisi.");

  var reqSheet = ss.getSheetByName(SHEET_REQ_PROFILE);
  if (!reqSheet) return err("Sheet ReqProfile tidak ditemukan.");

  reqSheet.getRange(rId, 7).setValue(statAct);

  if (statAct === "APPROVED") {
    var row = reqSheet.getRange(rId, 1, 1, 7).getValues()[0];
    var targetKode = String(row[2]||"");
    var changes = {};
    try { changes = JSON.parse(row[5]||"{}"); } catch(e){}

    if (targetKode) {
      var dmo = buildDepoMasterMaps(ss);
      var di  = dmo.codeToIdx[targetKode];
      if (di !== undefined) {
        var dmoSheet = ss.getSheetByName("DepoMaster");
        var dmRow    = dmoSheet.getRange(di+2, 1, 1, dmoSheet.getLastColumn()).getValues()[0];
        if (changes.kepalaDepot !== undefined) dmRow[3]  = changes.kepalaDepot;
        if (changes.kepalaAdmin !== undefined) dmRow[4]  = changes.kepalaAdmin;
        if (changes.alamat      !== undefined) dmRow[12] = changes.alamat;
        if (changes.sales       !== undefined) dmRow[17] = changes.sales;
        if (changes.admin       !== undefined) dmRow[18] = changes.admin;
        if (changes.fg          !== undefined) dmRow[19] = changes.fg;
        if (changes.pcc         !== undefined) dmRow[20] = changes.pcc;
        if (changes.teknisi     !== undefined) dmRow[21] = changes.teknisi;
        if (changes.driver      !== undefined) dmRow[22] = changes.driver;
        if (changes.lainnya     !== undefined) dmRow[23] = changes.lainnya;
        dmoSheet.getRange(di+2, 1, 1, dmRow.length).setValues([dmRow]);
      }
    }
  }
  invalidateDepoMasterCache();
  return ok({ message: "Profil request telah di-" + statAct });
}

function perbaikiGrossUpSekarang() {
  var ss = getSpreadsheet();
  var sheet = ss.getSheetByName("Compile");
  if (!sheet) return;

  // Baca data mulai dari baris ke-2 sampai akhir
  var data = sheet.getRange(2, 1, sheet.getLastRow() - 1, sheet.getLastColumn()).getValues();
  var grossUpUpdates = [];

  // Fungsi pembersih karakter uang
  function bersihkanAngka(val) {
    if (typeof val === 'number') return val;
    if (!val) return 0;
    var str = String(val).replace(/[^0-9,-]/g, '');
    str = str.replace(',', '.');
    return parseFloat(str) || 0;
  }

  for (var i = 0; i < data.length; i++) {
    var row = data[i];

    // MENGGUNAKAN INDEKS DINAMIS DARI KONSTANTA AGAR TIDAK SALAH KOLOM
    // Pastikan COL_COMPILE.CB_NET Anda sudah sesuai dengan kolom Net Cashback di Sheet
    var netCB = bersihkanAngka(row[COL_COMPILE.CB_NET]);
    var statusPajakCamp = row[COL_COMPILE.STATUS_PAJAK_CAMP];
    var subyekPajak = row[COL_COMPILE.SUBYEK_PAJAK];

    // Hitung Before Tax
    var newGrossUp = calcGrossUpCB(netCB, subyekPajak, statusPajakCamp);
    grossUpUpdates.push([newGrossUp]);
  }

  // Timpa ke Kolom Gross Up sesuai letak kolomnya di konstanta
  if (grossUpUpdates.length > 0) {
    sheet.getRange(2, COL_COMPILE.GROSS_UP + 1, grossUpUpdates.length, 1).setValues(grossUpUpdates);
  }

  Logger.log("Koreksi Selesai! Menggunakan data Net CB dari kolom indeks: " + COL_COMPILE.CB_NET);
}
