// =========================================================================
// MAIN ROUTER doPost
// =========================================================================
function doPost(e) {
  try {
    var ss = getSpreadsheet();
    var requestData = JSON.parse(e.postData.contents);
    var action = requestData.action;

    // 1. PUBLIC ROUTES (No Token Required)
    if (action === "login") return handleLogin(ss, requestData);
    if (action === "logActivity") return handleLogActivity(ss, requestData);

    // 2. AUTHENTICATION & SERVER-SIDE AUTHORIZATION
    var clientToken = requestData.token || (requestData.userData && requestData.userData.token);
    var authSession = verifyToken(clientToken);

    if (!authSession) {
      return err("Akses ditolak. Sesi tidak valid atau telah berakhir. Silakan login kembali.");
    }

    // Inject secure auth payload into request
    requestData.serverAuth = authSession;

    // 3. ROUTE TO HANDLER
    switch (action) {
      case "getLogActivity":       return handleGetLogActivity(ss, requestData);
      case "submitData":           return handleSubmitData(ss, requestData);
      case "getWorkflowData":      return handleGetWorkflowData(ss, requestData);
      case "refreshDocuments":     return handleRefreshDocuments(ss, requestData);
      case "processWorkflow":      return handleProcessWorkflow(ss, requestData);
      case "toggleOnHold":         return handleToggleOnHold(ss, requestData);
      case "markExpired":          return handleMarkExpired(ss, requestData);
      case "bulkFastTrackRelease": return handleBulkFastTrackRelease(ss, requestData);
      case "getDashboardData":     return handleGetDashboardData(ss, requestData);
      case "getManageableData":    return handleGetManageableData(ss, requestData);
      case "addAccount":           return handleAddAccount(ss, requestData);
      case "updateUserAccess":     return handleUpdateUserAccess(ss, requestData);
      case "requestPinChange":     return handleRequestPinChange(ss, requestData);
      case "submitProfileUpdate":  return handleSubmitProfileUpdate(ss, requestData);
      case "approveProfileRequest":return handleApproveProfileRequest(ss, requestData);
      default:                     return err("Action router tidak dikenal: " + action);
    }
  } catch (error) {
    Logger.log("ERROR doPost: " + error.toString() + "\n" + error.stack);
    return jsonOut({ status: "error", message: "Terjadi kesalahan sistem saat memproses request." });
  }
}

