function normalizeMonth(input) {
  if (!input) return "";
  var str = String(input).trim().toLowerCase();
  var dateMatch = str.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{2,4})$/);
  if (dateMatch) {
    var m = parseInt(dateMatch[2], 10);
    var y = dateMatch[3].length === 4 ? dateMatch[3].substring(2) : dateMatch[3];
    var mn = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    if (m >= 1 && m <= 12) return mn[m-1] + "-" + y;
  }
  var map = { jan:'Jan',peb:'Feb',feb:'Feb',mar:'Mar',apr:'Apr',mei:'May',may:'May',
              jun:'Jun',jul:'Jul',agu:'Aug',ags:'Aug',sep:'Sep',okt:'Oct',oct:'Oct',
              nov:'Nov',des:'Dec',dec:'Dec' };
  str = str.replace(/\s+/g, '-');
  var parts = str.split("-");
  if (parts.length === 2) {
    var mText = parts[0].replace(/[^a-z]/g, '');
    var resolved = map[mText] || parts[0];
    var y2 = parts[1].length === 4 ? parts[1].substring(2) : parts[1];
    return resolved.charAt(0).toUpperCase() + resolved.slice(1) + "-" + y2;
  }
  return input;
}

function normalizeName(name) {
  if (!name) return "";
  return String(name).trim().replace(/jatiasih/gi, "Bekasi");
}

function normalizeCurrency(input) {
  if (!input) return 0;
  var str = String(input).trim();
  if (str.indexOf('.') !== -1 && str.indexOf(',') !== -1) {
    str = str.replace(/\./g, '').replace(',', '.');
  } else if (str.indexOf(',') !== -1) {
    var p = str.split(',');
    str = p[p.length-1].length <= 2 ? str.replace(/,/g, '.') : str.replace(/,/g, '');
  }
  return parseFloat(str) || 0;
}

function normalizeRole(r) {
  r = r ? String(r).trim().toLowerCase() : '';
  if (r === 'system manager') return 'system manager';
  if (r === 'supervisor')     return 'supervisor';
  if (r === 'osc')            return 'osc';
  if (r === 'admin' || r === 'kepala depot') return 'admin';
  return 'non-osc';
}

function formatDateSafe(val) {
  if (!val) return "";
  if (val instanceof Date) return Utilities.formatDate(val, "Asia/Jakarta", "dd-MM-yyyy");
  var str = String(val).trim();
  var datePart = str.split(" ")[0];
  if (/^\d{1,2}-[A-Za-z]{3}-\d{4}$/.test(datePart)) return datePart;
  var m = datePart.match(/^(\d{1,2})[\/\-\.\s]+(\d{1,2})[\/\-\.\s]+(\d{2,4})$/);
  if (m) {
    var y = m[3].length === 2 ? "20" + m[3] : m[3];
    return ("0"+m[1]).slice(-2) + "-" + ("0"+m[2]).slice(-2) + "-" + y;
  }
  var d = new Date(val);
  return isNaN(d.getTime()) ? str : Utilities.formatDate(d, "Asia/Jakarta", "dd-MM-yyyy");
}

function extractYear(val) {
  if (!val) return "Lainnya";
  if (val instanceof Date) return String(val.getFullYear());
  var str = String(val).trim();
  var m1 = str.match(/\d{2}-[A-Za-z]{3}-(\d{4})/);
  if (m1) return m1[1];
  var m2 = str.match(/^(\d{4})[\/\-]/);
  if (m2) return m2[1];
  var d = new Date(str);
  return isNaN(d.getTime()) ? "Lainnya" : String(d.getFullYear());
}

// =========================================================================
// GROSS UP ENGINE (DIVISOR METHOD - BEFORE TAX) - REVISI ALL STATUS PAJAK
// =========================================================================
function calcGrossUpCB(netCB, subyekPajak, statusPajakCampaign) {
  var net = Number(netCB) || 0;
  if (net <= 0) return 0;

  var sp = String(subyekPajak || '').trim().toLowerCase();

  // Keterangan: Pengecualian (Bypass) untuk PT Nipsea / Ditanggung Perusahaan TELAH DIHAPUS.
  // Sekarang semua campaign dihitung Gross Up-nya berdasarkan entitas Badan/Pribadi.

  // Badan = Flat 15%. Formula Gross Up: Net / (1 - 0.15)
  if (sp === 'badan') {
    return net / 0.85;
  } else {
    // Perorangan/Pribadi (Layering Before Tax progresif)
    var gross = 0;
    if (net <= 57000000) { // Limit Gross 60jt (Tax 5% = 3jt, Net = 57jt)
      gross = net / 0.95;
    } else if (net <= 218500000) { // Limit Gross 250jt (Tax 15% = 28.5jt + 3jt)
      gross = 60000000 + ((net - 57000000) / 0.85);
    } else if (net <= 406000000) { // Limit Gross 500jt (Tax 25%)
      gross = 250000000 + ((net - 218500000) / 0.75);
    } else if (net <= 3556000000) { // Limit Gross 5M (Tax 30%)
      gross = 500000000 + ((net - 406000000) / 0.70);
    } else { // > 5M (Tax 35%)
      gross = 5000000000 + ((net - 3556000000) / 0.65);
    }
    return gross;
  }
}

// =========================================================================
// BATCH NUMBER GENERATOR
// =========================================================================
function generateSecureBatchNumber(stageCode, suffixNum) {
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    var ss = getSpreadsheet();
    var logSheet = ss.getSheetByName("BatchLog");
    if (!logSheet) {
      logSheet = ss.insertSheet("BatchLog");
      logSheet.appendRow(["Batch Number", "Stage", "Timestamp"]);
    }
    var today   = new Date();
    var dateStr = Utilities.formatDate(today, "Asia/Jakarta", "ddMMyy");
    var safeSfx = ("000" + (suffixNum || "000")).slice(-3);
    var prefix  = stageCode + safeSfx + dateStr;

    // Counter harian per stage di-cache (ScriptCache, TTL 6 jam) supaya tidak perlu scan ulang
    // SELURUH histori BatchLog (yang terus membesar tanpa batas) di setiap pembuatan nomor batch -
    // scan penuh itu berjalan di dalam LockService yang dipakai bersama submitData/processWorkflow/
    // bulkFastTrackRelease, jadi makin besar BatchLog makin lama lock ditahan dan makin sering
    // request lain timeout menunggu lock. Kalau cache kosong/kedaluwarsa, fallback ke scan sheet
    // seperti semula (logika identik) sehingga nomor batch tidak akan pernah salah/duplikat.
    var cache    = CacheService.getScriptCache();
    var cacheKey = "batchCtr_" + stageCode + "_" + dateStr;
    var maxCtr   = parseInt(cache.get(cacheKey), 10);

    if (isNaN(maxCtr)) {
      maxCtr = 0;
      var lastRow = logSheet.getLastRow();
      if (lastRow > 1) {
        var data = logSheet.getRange(2, 1, lastRow - 1, 1).getValues();
        for (var i = 0; i < data.length; i++) {
          var b = String(data[i][0]).trim();
          if (b.length >= 15 && b.substring(0,2) === stageCode && b.substring(5,11) === dateStr) {
            var ctr = parseInt(b.slice(-4), 10);
            if (!isNaN(ctr) && ctr > maxCtr) maxCtr = ctr;
          }
        }
      }
    }

    var nextCtr  = maxCtr + 1;
    var newBatch = prefix + ("0000" + nextCtr).slice(-4);
    logSheet.appendRow([newBatch, stageCode, Utilities.formatDate(today, "Asia/Jakarta", "dd-MMM-yyyy HH:mm:ss")]);
    cache.put(cacheKey, String(nextCtr), 21600);
    return newBatch;
  } finally {
    lock.releaseLock();
  }
}

// =========================================================================
// DEPOMASTER HELPER
// =========================================================================
// DepoMaster jarang berubah (hanya lewat addAccount/updateUserAccess/approveProfileRequest) tapi
// dibaca penuh di HAMPIR SETIAP request (login, workflow, dashboard, manageable data, dst) - di-cache
// 5 menit lewat ScriptCache supaya tidak scan ulang sheet ini terus-menerus. Invalidasi otomatis
// (invalidateDepoMasterCache) dipanggil setelah sheet ditulis, jadi perubahan tetap terlihat langsung.
var DEPOMASTER_CACHE_KEY = "depoMasterMapsV1";
var DEPOMASTER_CACHE_TTL = 300; // detik

function invalidateDepoMasterCache() {
  try { CacheService.getScriptCache().remove(DEPOMASTER_CACHE_KEY); } catch (e) {}
}

function buildDepoMasterMaps(ss) {
  var cache = CacheService.getScriptCache();
  try {
    var cached = cache.get(DEPOMASTER_CACHE_KEY);
    if (cached) return JSON.parse(cached);
  } catch (e) {}

  var res = readSheet(ss, "DepoMaster");
  var dm = res.data;
  var codeToIdx = {}, picMap = {}, nameMap = {}, subTagsMap = {};
  var oscMap = {}, nonOscMap = {}, oscDepotMap = {}, nonOscDepotMap = {};

  for (var i = 0; i < dm.length; i++) {
    var kode = String(dm[i][1] || "").trim();
    if (!kode) continue;
    codeToIdx[kode] = i;
    nameMap[kode]   = normalizeName(String(dm[i][2] || ""));
    picMap[kode]    = String(dm[i][10] || "").trim();

    var sub = String(dm[i][13] || "").trim();
    if (sub) subTagsMap[kode] = sub.split(",").map(function(s){ return s.trim().toUpperCase(); });

    var oscStr    = String(dm[i][10] || "");
    var nonOscStr = String(dm[i][11] || "");
    oscMap[kode]    = oscStr;
    nonOscMap[kode] = nonOscStr;

    oscStr.split(",").forEach(function(u) {
      u = u.trim(); if (!u) return;
      if (!oscDepotMap[u]) oscDepotMap[u] = [];
      oscDepotMap[u].push(kode);
    });
    nonOscStr.split(",").forEach(function(u) {
      u = u.trim(); if (!u) return;
      if (!nonOscDepotMap[u]) nonOscDepotMap[u] = [];
      nonOscDepotMap[u].push(kode);
    });
  }

  var result = { data: dm, codeToIdx: codeToIdx,
           picMap: picMap, nameMap: nameMap, subTagsMap: subTagsMap,
           oscMap: oscMap, nonOscMap: nonOscMap,
           oscDepotMap: oscDepotMap, nonOscDepotMap: nonOscDepotMap };

  // `sheet` (objek Sheet) sengaja tidak ikut di-cache karena tidak bisa di-serialize JSON dan
  // memang tidak dipakai oleh pemanggil manapun (semua handler ambil DepoMaster sheet sendiri
  // lewat ss.getSheetByName saat perlu menulis).
  try { cache.put(DEPOMASTER_CACHE_KEY, JSON.stringify(result), DEPOMASTER_CACHE_TTL); } catch (e) {}

  return result;
}

// Sumber kebenaran Jenis CB adalah master campaign (sheet ListCampaign, kolom G), bukan kolom
// JENIS_CB per-baris di Compile - kolom itu cuma snapshot yang ditulis sekali saat dokumen
// pertama kali di-upload, jadi dokumen lama tidak otomatis ikut ter-update kalau Jenis CB
// campaignnya baru diubah/ditambahkan jadi "Rebate" belakangan. Dipakai oleh handleGetWorkflowData
// dan handleBulkFastTrackRelease supaya keduanya konsisten memakai sumber yang sama.
function buildCampaignJenisCbMap(ss) {
  var campRes = readSheet(ss, SHEET_LIST_CAMPAIGN);
  var map = {};
  campRes.data.forEach(function(r) {
    var code = String(r[0] || "").trim().toUpperCase();
    if (!code) return;
    map[code] = String(r[6] || "").trim();
  });
  return map;
}

function resolveManagedDepots(explicitDepots, subTagsMap) {
  var result = [];
  explicitDepots.forEach(function(d) {
    if (result.indexOf(d) === -1) result.push(d);
    var subs = subTagsMap[d] || [];
    subs.forEach(function(s) { if (result.indexOf(s) === -1) result.push(s); });
  });
  return result;
}

