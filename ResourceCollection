      || (sysRole==='osc' && (picOsc===reqId || managed.indexOf(kd)!==-1))
      || managed.indexOf(kd) !== -1;
    if (!allowed) return;

    var statRaw = String(r[COL_COMPILE.STATUS]||"").trim();
    var statLow = statRaw.toLowerCase();
