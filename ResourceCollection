    var histStatus = (statRaw === "Done" || statLow === "ra07" || statLow === "ra7") ? "Done"
      : (statRaw==="Submitted"||statRaw==="Released"||statRaw==="Claimed") ? "Submitted"
      : statRaw === "On Hold" ? "On Hold"
      : statRaw === "Expired" ? "Expired"
      : "Not Yet";

    var year = extractYear(r[COL_COMPILE.TGL_UPLOAD] || r[COL_COMPILE.TGL_RELEASE] || r[COL_COMPILE.TGL_CLAIM] || r[COL_COMPILE.TGL_CLEARING]);

    history.push({
      noDoc: noDoc, kodeToko: String(r[COL_COMPILE.CUST_CODE]||"").trim(),
      namaToko: normalizeName(String(r[COL_COMPILE.CUST_NAME]||"")),
      codeCampaign: String(r[COL_COMPILE.CODE_CAMPAIGN]||"").trim(), campaign: String(r[COL_COMPILE.CAMPAIGN_NAME]||"").trim(),
      periode: formatDateSafe(r[COL_COMPILE.PERIOD_START]) + " s/d " + formatDateSafe(r[COL_COMPILE.CAMPAIGN_END]),
      totalClaim: r[COL_COMPILE.CB_NET] || 0, grossUpCb: r[COL_COMPILE.GROSS_UP] || 0, status: histStatus,
      tglProses: statRaw==="Done" ? formatDateSafe(r[COL_COMPILE.TGL_CLEARING]) : "-",
      tglUpload:   formatDateSafe(r[COL_COMPILE.TGL_UPLOAD]), tglRelease:  formatDateSafe(r[COL_COMPILE.TGL_RELEASE]),
      tglClaimFin: formatDateSafe(r[COL_COMPILE.TGL_CLAIM]), tglClearing: formatDateSafe(r[COL_COMPILE.TGL_CLEARING]),
      batchUpload:   String(r[COL_COMPILE.BATCH_UPLOAD]||""), batchRelease:  String(r[COL_COMPILE.BATCH_RELEASE]||""),
      batchClaim:    String(r[COL_COMPILE.BATCH_CLAIM]||""), batchClearing: String(r[COL_COMPILE.BATCH_CLEARING]||""),
      osc: picOsc, depot: depot, kodeDepot: kd,
      subyekPajak: String(r[COL_COMPILE.SUBYEK_PAJAK]||"").trim(), statusPajak: String(r[COL_COMPILE.STATUS_PAJAK_CAMP]||"").trim(),
      campaignYear: year
    });

    compileData.push({
      depotCode: kd, depotName: depot,
      codeCampaign: String(r[COL_COMPILE.CODE_CAMPAIGN]||"").trim(), campaign: String(r[COL_COMPILE.CAMPAIGN_NAME]||"").trim(),
      reward: r[COL_COMPILE.CB_NET] || 0, campaignYear: year
    });
  });

  return ok({ history: history, compileData: compileData });
}

function handleGetManageableData(ss, requestData) {
  var requesterId = requestData.requesterId;
  var sysRole     = normalizeRole(requestData.requesterRole);

  var dmo     = buildDepoMasterMaps(ss);
  var authRes = readSheet(ss, SHEET_AUTHORITY);

  var explicitDepots = [];
  dmo.data.forEach(function(dm) {
    var kode = String(dm[1]||"").trim().toUpperCase(); if (!kode) return;
    var oscArr    = String(dm[10]||"").split(",").map(function(u){return u.trim();});
    var nonOscArr = String(dm[11]||"").split(",").map(function(u){return u.trim();});
    if (sysRole==="supervisor"||sysRole==="system manager"
       ||oscArr.indexOf(requesterId)!==-1||nonOscArr.indexOf(requesterId)!==-1)
      explicitDepots.push(kode);
  });

  var managedDepots = resolveManagedDepots(explicitDepots, dmo.subTagsMap);
  var allDepots = [];

  dmo.data.forEach(function(dm) {
    var dc = String(dm[1]||"").trim().toUpperCase(); if (!dc) return;
    if (sysRole==="system manager" || managedDepots.indexOf(dc)!==-1)
      allDepots.push({ kode: dc, nama: normalizeName(String(dm[2]||"")),
                       link: String(dm[12]||"").trim() });
  });

  var manageableUsers = authRes.data
    .filter(function(a) {
      var uid = String(a[4]||"").trim();
      if (uid === requesterId) return false;
      var uSysRole = normalizeRole(String(a[7]||""));
      if (sysRole==="system manager") return true;
      if (sysRole==="supervisor")
        return uSysRole==="osc"||uSysRole==="non-osc"||uSysRole==="admin";
      return false;
    })
    .map(function(a) {
      var uid   = String(a[4]||"").trim();
      var uRole = String(a[7]||"").trim() || "admin";
      var uSys  = normalizeRole(uRole);
      var kd    = String(a[2]||"").trim();
      return {
        userId: uid, namaLengkap: String(a[1]||""), email: String(a[6]||""),
        depotName: normalizeName(String(a[3]||"")), kodeDepot: kd,
        role: uRole, sysRole: uSys,
        activation: String(a[8]||"denied"),
        auth: {
          i: String(a[8] ||"") || "Inactive", j: String(a[9] ||"") || "Hidden",
          k: String(a[10]||"") || "No",        l: String(a[11]||"") || "No",
          m: String(a[12]||"") || "No",        n: String(a[13]||"") || "No",
          p: String(a[15]||"") || "No",        q: String(a[16]||"") || "No",
          s: String(a[18]||"") || "No"
        },
        pinStatus: a[14] ? "pending" : "",
        assignedOsc:    uSys==="osc"     ? (dmo.oscDepotMap[uid]    || []) : (dmo.oscMap[kd] || ""),
        assignedDepots: uSys==="non-osc" ? (dmo.nonOscDepotMap[uid] || []) : []
      };
    });

  var reqRes  = readSheet(ss, SHEET_REQ_PROFILE);
  var requests = [];
  if (sysRole==="supervisor"||sysRole==="system manager") {
    reqRes.data.forEach(function(r, idx) {
      if (String(r[6]||"") !== "PENDING") return;
      var ch = {};
      try { ch = JSON.parse(r[5]||"{}"); } catch(e){}
      requests.push({
        id: idx+2, tglRequest: formatDateSafe(r[0]), role: String(r[1]||""),
        kodeDepot: String(r[2]||""), namaDepot: String(r[3]||""),
        requesterId: String(r[4]||""), changes: ch
      });
    });
  }

  return ok({ users: manageableUsers, managedDepots: managedDepots,
              allDepots: allDepots, profileRequests: requests });
}

function handleAddAccount(ss, requestData) {
  var reqData = requestData.data;
  if (!reqData || !reqData.userId || !reqData.pin) return err("Data akun tidak lengkap.");

  var authRes  = readSheet(ss, SHEET_AUTHORITY);
  var authSheet= authRes.sheet || ss.getSheetByName(SHEET_AUTHORITY);

  var exists = authRes.data.some(function(a){ return String(a[4]).trim() === String(reqData.userId).trim(); });
  if (exists) return err("User ID sudah terdaftar! Gunakan ID lain.");

  var dmo       = buildDepoMasterMaps(ss);
  var dm        = dmo.data;
  var dmoSheet  = ss.getSheetByName("DepoMaster");
  var roleCheck = (reqData.role||"").toLowerCase();
  var isAdmin   = (roleCheck==="admin"||roleCheck==="kepala depot");
  var isOscNon  = (!isAdmin && roleCheck!=="supervisor" && roleCheck!=="system manager");

  var regAuto = "0", kodeDepotAuto = "0", inputDepotName = reqData.depotName || "Head Office";

  if (isAdmin) {
    var tIdx = dmo.codeToIdx[reqData.depotCode];
    if (tIdx === undefined) return err("Kode Depot tidak ditemukan di Master!");
    regAuto = String(dm[tIdx][0]); kodeDepotAuto = String(dm[tIdx][1]);
    inputDepotName = dmo.nameMap[kodeDepotAuto];

    var slotCol = -1;
    for (var col = 7; col <= 9; col++) {
      if (!String(dm[tIdx][col]||"").trim()) { slotCol = col; break; }
    }
    if (slotCol === -1) return err("Gagal: Slot User Admin di depot ini sudah penuh!");
    dmoSheet.getRange(tIdx + 2, slotCol + 1).setValue(reqData.userId);

    if (reqData.assignOsc) {
      var curOsc = String(dmoSheet.getRange(tIdx+2, 11).getValue()||"");
      if (curOsc.indexOf(reqData.assignOsc) === -1)
        dmoSheet.getRange(tIdx+2, 11).setValue(curOsc ? curOsc+", "+reqData.assignOsc : reqData.assignOsc);
    }
  } else if (isOscNon && reqData.assignAdmin) {
    var targets = reqData.assignAdmin.split(",").map(function(s){return s.trim();});
    var allFlag = targets.indexOf("ALL_DEPOT")!==-1 || targets.indexOf("ALL")!==-1;
    var colU    = (roleCheck==="osc") ? 11 : 12;

    var dmWrites = {};
    dm.forEach(function(row, ri) {
      var dc = String(row[1]||"").trim(); if (!dc) return;
      if (!allFlag && targets.indexOf(dc)===-1) return;
      var cur = String(row[colU-1]||"").trim();
      if (cur.indexOf(reqData.userId)===-1)
        dmWrites[ri] = cur ? cur+", "+reqData.userId : reqData.userId;
    });
    Object.keys(dmWrites).forEach(function(ri){
      dmoSheet.getRange(parseInt(ri)+2, colU).setValue(dmWrites[ri]);
    });
  }

  var newRow = ["","","","","","","","","Yes","Yes","Yes","Yes","Yes","Hidden","","No","","000"];
  newRow[0]=regAuto; newRow[1]=reqData.nama; newRow[2]=kodeDepotAuto;
  newRow[3]=inputDepotName; newRow[4]=reqData.userId; newRow[5]=reqData.pin;
  newRow[6]=reqData.email||""; newRow[7]=reqData.role; newRow[8]="active";
  authSheet.appendRow(newRow);
  invalidateDepoMasterCache();
  return ok({ message: "Berhasil memproses akun." });
}

function handleUpdateUserAccess(ss, requestData) {
  var reqData = requestData.data;
  if (!reqData || !reqData.targetUserId) return err("targetUserId tidak ada.");

  var authRes  = readSheet(ss, SHEET_AUTHORITY);
  var authSheet= authRes.sheet;
  var tRow     = -1;

  for (var u = 0; u < authRes.data.length; u++) {
    if (String(authRes.data[u][4]).trim() === String(reqData.targetUserId).trim()) { tRow = u; break; }
  }
  if (tRow === -1) return err("User tidak ditemukan.");

  var rv = authRes.data[tRow].slice();
  if (reqData.auth) {
    if (reqData.auth.i !== undefined) rv[8]  = reqData.auth.i;
    if (reqData.auth.j !== undefined) rv[9]  = reqData.auth.j;
    if (reqData.auth.k !== undefined) rv[10] = reqData.auth.k;
    if (reqData.auth.l !== undefined) rv[11] = reqData.auth.l;
    if (reqData.auth.m !== undefined) rv[12] = reqData.auth.m;
    if (reqData.auth.n !== undefined) rv[13] = reqData.auth.n;
    if (reqData.auth.p !== undefined) rv[15] = reqData.auth.p;
    if (reqData.auth.s !== undefined) rv[18] = reqData.auth.s;
  }

  if (reqData.q !== undefined) rv[16] = reqData.q;
  if (reqData.approvePin && rv[14]) { rv[5] = rv[14]; rv[14] = ""; }

  var sheetRow = tRow + 2;
  authSheet.getRange(sheetRow, 1, 1, rv.length).setValues([rv]);

  var reqSysRole = normalizeRole(requestData.requesterRole);
  if (reqSysRole==="supervisor"||reqSysRole==="system manager") {
    var uRole = String(authRes.data[tRow][7]||"").trim().toLowerCase();
    var dmo   = buildDepoMasterMaps(ss);
    var dmoSheet = ss.getSheetByName("DepoMaster");

    if (uRole==="admin" && reqData.assignOsc !== undefined) {
      var kd2 = String(authRes.data[tRow][2]).trim();
      var di  = dmo.codeToIdx[kd2];
      if (di !== undefined) dmoSheet.getRange(di+2, 11).setValue(reqData.assignOsc);

    } else if (uRole!=="admin"&&uRole!=="supervisor"&&uRole!=="system manager"
               && reqData.assignDepots !== undefined) {
      var targets = Array.isArray(reqData.assignDepots)
        ? reqData.assignDepots
        : String(reqData.assignDepots).split(",").map(function(s){return s.trim();});
      var allFlag = targets.indexOf("ALL_DEPOT")!==-1||targets.indexOf("ALL")!==-1;
      var colU    = (uRole==="osc") ? 11 : 12;

      dmo.data.forEach(function(row, ri) {
        var dc = String(row[1]||"").trim(); if (!dc) return;
        var cur = String(row[colU-1]||"").trim();
        var arr = cur ? cur.split(",").map(function(s){return s.trim();}) : [];
        var idx = arr.indexOf(reqData.targetUserId);
        var want= allFlag || targets.indexOf(dc)!==-1;
        if (want && idx===-1)       { arr.push(reqData.targetUserId); dmoSheet.getRange(ri+2,colU).setValue(arr.join(", ")); }
        else if (!want && idx!==-1) { arr.splice(idx,1); dmoSheet.getRange(ri+2,colU).setValue(arr.join(", ")); }
      });
    }
  }
  invalidateDepoMasterCache();
  return ok({ message: "Hak akses matriks berhasil diperbarui." });
}

