{
  "name": "rc-next-gen",
  "version": "0.1.0",
  "private": true,
  "description": "Resource Collection claim system on Supabase, deployed as a static frontend on Vercel.",
  "type": "module",
  "scripts": {
    "perf:run": "node scripts/performance/run.mjs",
    "perf:plan:test": "node --test --test-isolation=none scripts/performance/test_plan.mjs",
    "perf:dataset": "python scripts/performance/generate_dataset.py --out .runtime/performance/dataset-1m",
