// ----------------------------------------------------------------------------
// EXISTING-KEYS INDEX (Upload) — Incremental Cache untuk Cek Duplikat
//
// Sebelumnya setiap submit membaca ULANG seluruh baris Upload (kolom C & G).
// Ini O(total baris histori) setiap kali, dan berjalan DI DALAM Lock,
// sehingga makin banyak data historis -> makin lama tiap submit -> makin
// panjang antrean user lain.
//
// Sekarang: index (Set berisi "kodeCampaign_custCode") disimpan di
// CacheService (shared, script-level). Saat submit baru masuk, kita HANYA
// membaca baris baru yang belum ter-index (delta), bukan seluruh sheet.
// Jika cache kosong/kadaluarsa (maks 6 jam), otomatis full-rebuild sekali
// (self-healing), lalu kembali cepat untuk submit-submit berikutnya.
// ----------------------------------------------------------------------------
function loadExistingKeysIndex() {
  const cache = CacheService.getScriptCache();
  const metaRaw = cache.get(UPLOAD_INDEX_META_KEY);
  if (!metaRaw) return null; // cache miss -> caller akan full rebuild

  let meta;
  try { meta = JSON.parse(metaRaw); } catch (e) { return null; }

  const chunkKeys = [];
  for (let i = 0; i < meta.chunkCount; i++) chunkKeys.push(UPLOAD_INDEX_CHUNK_PREFIX + i);

  const chunks = chunkKeys.length ? cache.getAll(chunkKeys) : {};
  const keys = new Set();

  for (let i = 0; i < meta.chunkCount; i++) {
    const raw = chunks[UPLOAD_INDEX_CHUNK_PREFIX + i];
    if (raw === null || raw === undefined) return null; // chunk hilang/expired -> full rebuild demi konsistensi
    try {
      const arr = JSON.parse(raw);
      for (let j = 0; j < arr.length; j++) keys.add(arr[j]);
    } catch (e) {
      return null;
    }
  }

  return { keys: keys, lastRow: meta.lastRow };
}

function saveExistingKeysIndex(keysSet, lastRow) {
  try {
    const cache = CacheService.getScriptCache();
    const arr = Array.from(keysSet);
    const chunkCount = Math.max(1, Math.ceil(arr.length / UPLOAD_INDEX_CHUNK_SIZE));

    const payload = {};
    for (let i = 0; i < chunkCount; i++) {
      const slice = arr.slice(i * UPLOAD_INDEX_CHUNK_SIZE, (i + 1) * UPLOAD_INDEX_CHUNK_SIZE);
      payload[UPLOAD_INDEX_CHUNK_PREFIX + i] = JSON.stringify(slice);
    }
    payload[UPLOAD_INDEX_META_KEY] = JSON.stringify({ lastRow: lastRow, chunkCount: chunkCount });

    cache.putAll(payload, UPLOAD_INDEX_TTL);
  } catch (e) {
    // Jika gagal simpan (mis. ukuran data tak wajar), abaikan saja.
    // Submit berikutnya akan full-rebuild dari sheet -> tetap benar, hanya sedikit lebih lambat sekali.
    console.error("Gagal menyimpan index cache Upload: " + e.message);
  }
}

/**
 * Mengambil Set existing keys ("kodeCampaign_custCode") dari Upload, dengan
 * strategi baca DELTA (hanya baris baru) jika cache index masih valid.
 * Dipanggil DI DALAM Lock agar konsisten dengan operasi tulis berikutnya.
 */
function getExistingKeysForDedup(sheetUpload, currentLastRow) {
  const cached = loadExistingKeysIndex();

  if (cached) {
    const existingKeys = cached.keys;
    if (currentLastRow > cached.lastRow) {
      const startRow = Math.max(3, cached.lastRow + 1);
      if (currentLastRow >= startRow) {
        const deltaData = sheetUpload.getRange(startRow, 3, currentLastRow - startRow + 1, 5).getValues();
        for (let i = 0; i < deltaData.length; i++) {
          const kc = String(deltaData[i][0]).trim(); // Kolom C
          const cc = String(deltaData[i][4]).trim(); // Kolom G
          if (kc && cc) existingKeys.add(kc + "_" + cc);
        }
      }
    }
    return existingKeys;
  }

  // Cache miss / kadaluarsa -> full rebuild (fallback, sama seperti versi lama)
  const existingKeys = new Set();
  if (currentLastRow >= 3) {
    const regData = sheetUpload.getRange(3, 3, currentLastRow - 2, 5).getValues();
    for (let i = 0; i < regData.length; i++) {
      const kc = String(regData[i][0]).trim(); // Kolom C
      const cc = String(regData[i][4]).trim(); // Kolom G
      if (kc && cc) existingKeys.add(kc + "_" + cc);
    }
  }
  return existingKeys;
}

/**
 * ALUR SUBMIT HIGH-EFFICIENCY
 */
function processSubmitCashback(dataToSubmit, userName) {
  // 1. PRE-PROCESSING (Di luar Lock agar tidak memakan antrean)
  const depotMap = getDepotMap(); // Ambil Map dari Cache
  const timestamp = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "dd/MM/yyyy - HH:mm:ss");

  // Filter duplikasi internal di dalam file yg diupload (mencegah error saat looping)
  const uniqueBatch = [];
  const rejectedData = [];
  const internalKeys = new Set();

  for (let i = 0; i < dataToSubmit.length; i++) {
    const row = dataToSubmit[i];
    const key = String(row.kodeCampaign).trim() + "_" + String(row.custCode).trim();
    if (internalKeys.has(key)) {
      rejectedData.push(row);
    } else {
      internalKeys.add(key);
      uniqueBatch.push(row);
    }
  }

  // Data diterima disimpan per-GRUP KOLOM (bukan 1 array 21-kolom penuh),
  // supaya saat insert nanti kita cuma nulis ke kolom yang memang dipakai
  // script — kolom rumus lain di baris yg sama tidak pernah disentuh/ditimpa.
  const colC = [];    // Kolom C  : kodeCampaign
  const colE = [];    // Kolom E  : dc
  const colGHI = [];  // Kolom G-I: custCode, custName, netValue
  const colK = [];    // Kolom K  : total (CB)
  const colNO = [];   // Kolom N-O: jenisCb, beforeTaxVal
  const colTU = [];   // Kolom T-U: timestamp, userName
  const summaryMap = {};
  let validCount = 0;

  // 2. CRITICAL SECTION (Lock dimulai hanya jika ada data unik)
  if (uniqueBatch.length > 0) {
    const lock = LockService.getScriptLock();
    try {
      lock.waitLock(30000); // Tunggu maks 30 detik untuk handle concurrent users

      const ss = getSS(COMPILE_SS_ID);
      const sheetUpload = ss.getSheetByName("Upload");
      if (!sheetUpload) throw new Error("Sheet 'Upload' tidak ditemukan di spreadsheet COMPILE_SS_ID. Cek nama tab, mungkin berbeda/berubah.");

      // FIX: pakai kolom acuan C (bukan getLastRow() bawaan), supaya tidak
      // ketarik jauh ke bawah oleh kolom-kolom rumus lain di sheet Upload.
      const lastRow = getRealLastRow(sheetUpload, UPLOAD_ANCHOR_COL);

      // Ambil existing keys SECEPAT MUNGKIN: delta dari cache index, bukan full-scan
      const existingKeys = getExistingKeysForDedup(sheetUpload, lastRow);

      // Filter terhadap data di Database
      for (let i = 0; i < uniqueBatch.length; i++) {
        const row = uniqueBatch[i];
        const key = String(row.kodeCampaign).trim() + "_" + String(row.custCode).trim();

        if (existingKeys.has(key)) {
          rejectedData.push(row);
        } else {
          // Push HANYA ke kolom yang diisi script. Kolom rumus lain (A,B,D,F,
          // J,L,M,P,Q,R,S) tidak pernah dibuat/ditulis di sini sama sekali.
          colC.push([String(row.kodeCampaign).trim()]);                 // C
          colE.push([row.dc]);                                          // E
          colGHI.push([String(row.custCode).trim(), row.custName, row.netValue]); // G,H,I
          colK.push([row.total]);                                       // K
          colNO.push([row.jenisCb, row.beforeTaxVal]);                  // N,O
          colTU.push([timestamp, userName]);                            // T,U

          existingKeys.add(key); // langsung tandai terpakai, cegah duplikat dalam summary/cache

          // Build Summary (Di memori)
          const namaDepot = depotMap[String(row.dc).trim()] || row.dc;
          const summaryKey = namaDepot + "_" + row.namaCampaign;
          if (!summaryMap[summaryKey]) {
            summaryMap[summaryKey] = { namaDepot, namaCampaign: row.namaCampaign, totalReward: 0, qtyToko: 0 };
          }
          summaryMap[summaryKey].totalReward += Number(row.total) || 0;
          summaryMap[summaryKey].qtyToko += 1;
        }
      }

      // Batch Insert ke DB — HANYA ke kolom yang berisi data (C, E, G:I, K,
      // N:O, T:U), lewat beberapa setValues() kecil, BUKAN 1x ke seluruh A:U.
      // Kolom rumus lain (A,B,D,F,J,L,M,P,Q,R,S) sama sekali tidak disentuh,
      // jadi rumus yang sudah ada di baris tsb tidak ikut tertimpa/terhapus.
      let newLastRow = lastRow;
      if (colC.length > 0) {
        const insertRow = lastRow < 2 ? 3 : lastRow + 1;
        const n = colC.length;

        sheetUpload.getRange(insertRow, 3, n, 1).setValues(colC);    // C
        sheetUpload.getRange(insertRow, 5, n, 1).setValues(colE);    // E
        sheetUpload.getRange(insertRow, 7, n, 3).setValues(colGHI);  // G:I
        sheetUpload.getRange(insertRow, 11, n, 1).setValues(colK);   // K
        sheetUpload.getRange(insertRow, 14, n, 2).setValues(colNO);  // N:O
        sheetUpload.getRange(insertRow, 20, n, 2).setValues(colTU);  // T:U

        SpreadsheetApp.flush(); // pastikan tertulis permanen sebelum lock dilepas & lastRow berikutnya dibaca
        validCount = n;
        newLastRow = insertRow + n - 1;
      }

      // Update index cache (delta yang sudah dibaca + key baru yang baru masuk)
      // sehingga submit BERIKUTNYA tidak perlu baca ulang dari awal.
      saveExistingKeysIndex(existingKeys, newLastRow);

    } catch (e) {
      // Catat error ASLI ke log Executions (Apps Script) untuk diagnosis.
      // Pesan ke frontend tetap generik (UX), tapi sekarang penyebab sebenarnya
      // tidak lagi "hilang" — cek menu Executions di Apps Script untuk detail.
      console.error("processSubmitCashback gagal: " + e.message);
      return jsonOut({ success: false, message: "Server sibuk memproses data user lain. Silakan coba beberapa detik lagi." });
    } finally {
      // Buka gembok SECEPAT MUNGKIN agar user lain bisa masuk.
      // Guard: hanya release jika waitLock() berhasil (hasLock true),
      // supaya tidak melempar error baru saat waitLock() itu sendiri gagal/timeout
      // (error baru di sini akan menutupi pesan error asli di atas).
      if (lock.hasLock()) {
        lock.releaseLock();
      }
    }
  }

  // 3. POST-PROCESSING (Log activity dipanggil SETELAH lock dilepas agar sangat efisien)
  if (validCount > 0) {
    logActivity(`User ${userName} submit Compile Cashback. Valid: ${validCount}, Ditolak: ${rejectedData.length}`);
  }

  return jsonOut({
    success: true,
    message: `${validCount} data berhasil disimpan. ${rejectedData.length} data duplikat ditolak.`,
    summary: Object.values(summaryMap),
    rejected: rejectedData
  });
}