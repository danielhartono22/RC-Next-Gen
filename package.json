    "check:sql": "node scripts/check-sql-refs.mjs",
    "sql": "node scripts/apply-sql.mjs",
    "sql:check": "node scripts/apply-sql.mjs --check",
    "test:access:db": "node scripts/test_access_registration.mjs",
    "audit:application": "node scripts/audit-application.mjs",
    "test:release:db": "node scripts/test_rc_2309.mjs",
    "test:user-upload:db": "node scripts/test_user_upload.mjs",
    "test:user-upload:http": "node scripts/test_registration_http.mjs --upload"
  },
  "engines": {
    "node": ">=20"
  }
