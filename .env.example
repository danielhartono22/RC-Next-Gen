# Values used by operator tooling only. Nothing here is read by the browser: the frontend
# gets its public project URL and publishable key from config/rc-env.js, which is deployed
# as a static asset. Never put a service_role or secret key in config/rc-env.js.
#
# Copy to .env (already covered by .gitignore) and fill in locally.

# Legacy service_role JWT for scripts/sync_rc.py snapshot import. Operator machine only.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SECRET_FROM_YOUR_PRIVATE_ENVIRONMENT

# Supabase project reference for CLI work against DEV.
SUPABASE_PROJECT_REF=vvojshgcduqlugngpzkj

# Personal access token for `supabase login --token`, when applying migrations from the CLI.
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
