    "baseline": "node scripts/make-structure-baseline.mjs",
    "split": "node scripts/split-rc-source.mjs",
    "backup": "node scripts/backup-supabase.mjs",
    "bundle": "node scripts/make-apply-bundle.mjs --skip 20260916010000 --skip 20260917010000 --skip 20260917020000 --skip 20260918010000 --skip 20260919010000 --skip 20260920010000 --skip 20260921010000 --skip 20260922010000 --skip 20260923010000 --skip 20260924010000 --skip 20260925010000 --skip 20260926010000 --skip 20260927010000 --skip 20260928010000 --skip 20260929010000 --skip 20260930010000 --skip 20261001010000 --skip 20261002010000 --skip 20261003010000 --skip 20261004010000 --skip 20261005010000 --skip 20261006010000 --skip 20261007010000 --skip 20261008010000 --skip 20261009010000 --skip 20261010010000 --skip 20261011010000 --skip 20261012010000 --skip 20261013010000 --skip 20261014010000 --skip 20261015010000 --skip 20261016010000 --skip 20261017010000 --skip 20261018010000 --skip 20261019010000 --skip 20261020010000 --skip 20261021010000 --skip 20261022010000 --skip 20261023010000 --skip 20261024010000 --skip 20261025010000 --skip 20261026010000 --skip 20261027010000 --skip 20261028010000",
    "diagnose": "node scripts/diagnose-auth.mjs",
