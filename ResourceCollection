function getSpreadsheet() {
  return SpreadsheetApp.openById(CONFIG[ENV].SPREADSHEET_ID);
}

function readSheet(ss, name) {
  var sh = ss.getSheetByName(name);
  if (!sh || sh.getLastRow() < 2) return { sheet: sh, data: [] };
  var data = sh.getRange(2, 1, sh.getLastRow() - 1, sh.getLastColumn()).getValues();
  return { sheet: sh, data: data };
}

// =========================================================================
// SECURITY & AUTHENTICATION (STATELESS TOKEN)
// =========================================================================
function generateToken(userId, role, suffixNum) {
  var header = Utilities.base64EncodeWebSafe(JSON.stringify({alg: "HS256", typ: "JWT"}));
  var exp = new Date().getTime() + (12 * 60 * 60 * 1000); // 12 Hours
  var payload = Utilities.base64EncodeWebSafe(JSON.stringify({ userId: userId, role: role, suffixNum: suffixNum, exp: exp }));
  var signature = Utilities.computeHmacSha256Signature(header + "." + payload, SECRET_KEY);
  return header + "." + payload + "." + Utilities.base64EncodeWebSafe(signature);
}

function verifyToken(token) {
  if (!token) return null;
  try {
    var parts = token.split('.');
    if (parts.length !== 3) return null;
    var signature = Utilities.computeHmacSha256Signature(parts[0] + "." + parts[1], SECRET_KEY);
    if (Utilities.base64EncodeWebSafe(signature) !== parts[2]) return null;

    var payloadStr = Utilities.newBlob(Utilities.base64DecodeWebSafe(parts[1])).getDataAsString();
    var payload = JSON.parse(payloadStr);
    if (new Date().getTime() > payload.exp) return null; // Expired
    return payload;
  } catch (e) {
    return null;
  }
}

// =========================================================================
// STATE MACHINE VALIDATOR
// =========================================================================
function isValidStatusTransition(currentStatus, targetStatus) {
  var cur = (currentStatus || WORKFLOW_STATUS.NOT_YET).trim().toLowerCase();
  var tar = (targetStatus || "").trim().toLowerCase();

  if (cur === "expired") return false; // TERMINAL STATE. Kunci absolut.

  var transitions = {
    "not yet": ["submitted", "on hold", "expired"],
    "submitted": ["released", "on hold", "expired", "done"],
    "released": ["claimed", "expired", "submitted"], // submitted = jika reject_release
    "claimed": ["done", "expired", "released"],      // released = jika reject_claim
    "on hold": ["not yet", "submitted"]
  };

  // Override untuk action reject
  if (tar === "reject_release") return cur === "submitted";
  if (tar === "reject_claim") return cur === "released";
  if (tar === "reject_clearing") return cur === "claimed";

  return transitions[cur] && transitions[cur].indexOf(tar) !== -1;
}

